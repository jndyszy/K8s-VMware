# 阶段 4：frr-router 的 /etc/config/dhcp 快照（uci export dhcp）
# dnsmasq：上游为 4 台节点 resolved（noresolv + server），lab.internal 只本地应答（local），LAN 不发 DHCP/RA
package dhcp

config dnsmasq
	option domainneeded '1'
	option boguspriv '1'
	option filterwin2k '0'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/lab.internal/'
	option domain 'lab.internal'
	option expandhosts '1'
	option nonegcache '0'
	option cachesize '1000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option nonwildcard '1'
	option localservice '1'
	option ednspacket_max '1232'
	option filter_aaaa '0'
	option filter_a '0'
	option noresolv '1'
	list server '10.10.10.10'
	list server '10.10.10.11'
	list server '10.10.10.12'
	list server '10.10.10.13'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv4 'server'
	option dhcpv6 'disabled'
	option ra 'disabled'
	option ra_slaac '1'
	list ra_flags 'managed-config'
	list ra_flags 'other-config'
	option ignore '1'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/odhcpd.leases'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'
	option piodir '/tmp/odhcpd-piodir'
	option hostsdir '/tmp/hosts'

config disabled 'ra'

config domain
	option name 'grafana.lab.internal'
	option ip '10.200.0.10'

config domain
	option name 'argocd.lab.internal'
	option ip '10.200.0.11'

config domain
	option name 'lab-api.lab.internal'
	option ip '10.200.0.20'

config domain
	option name 'frr-router.lab.internal'
	option ip '10.10.10.20'

config domain
	option name 'k8s-master.lab.internal'
	option ip '10.10.10.10'

config domain
	option name 'k8s-worker-1.lab.internal'
	option ip '10.10.10.11'

config domain
	option name 'k8s-worker-2.lab.internal'
	option ip '10.10.10.12'

config domain
	option name 'k8s-worker-3.lab.internal'
	option ip '10.10.10.13'

